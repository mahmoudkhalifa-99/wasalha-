rules_version = '2';

// قواعد Firestore لتطبيق وصلها.
// انشرها من: firebase deploy --only firestore:rules
// (أو الصقها في Firebase Console ← Firestore Database ← Rules ← Publish)
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────── دوال مساعدة ─────────────
    function signedIn() {
      return request.auth != null;
    }

    function adminEmails() {
      // لازم تطابق adminEmails في lib/constants.dart
      return [
        'admin@ashmoun.com',
        'mahmoudkhalifa.kh91@gmail.com',
        'sadat.planning.officer@dakahlia.net',
        'admin@wasalah.com',
        'wasalah.app@gmail.com'
      ];
    }

    // حسابات مستثناة من تأكيد البريد (لازم تطابق verificationExemptEmails في constants.dart)
    function exemptEmails() {
      return [
        'admin@ashmoun.com',
        'mahmoudkhalifa.kh91@gmail.com',
        'superadmin@ashmoun.com'
      ];
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return me().role;
    }

    // ADMIN = السوبر أدمن | OPERATOR = المشغّل
    function isAdmin() {
      return signedIn() && myRole() == 'ADMIN';
    }

    function isStaff() {
      return signedIn() && myRole() in ['ADMIN', 'OPERATOR'];
    }

    // الحساب المعطّل ما يقدرش يكتب أي حاجة
    function notSuspended() {
      return me().get('status', 'APPROVED') != 'SUSPENDED';
    }

    // البريد لازم يكون متأكد (حسابات جوجل متأكدة تلقائياً، والمستثنون في exemptEmails)
    function emailOk() {
      return request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider != 'password'
          || request.auth.token.email.lower() in exemptEmails();
    }

    function canWrite() {
      return signedIn() && emailOk() && notSuspended();
    }

    // ───────────── المستخدمون ─────────────
    function validNewUser(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'email', 'phone', 'name', 'role', 'status',
                               'photoURL', 'vehicleType', 'plateNumber',
                               'operatorId', 'zoneId', 'wallet', 'location'])
          && d.get('id', uid) == uid
          && d.email.lower() == request.auth.token.email.lower()
          // الرتبة: عميل أو كابتن بس. الأدمن بيتعمل بإيميل أدمن متأكد فقط.
          && (d.role in ['CUSTOMER', 'DRIVER']
              || (d.role == 'ADMIN'
                  && request.auth.token.email_verified == true
                  && request.auth.token.email.lower() in adminEmails()))
          && d.get('status', 'APPROVED') == 'APPROVED'
          // المحفظة تبدأ بصفر، ولا أحد يحط رصيد لنفسه
          && d.wallet.balance == 0
          && d.wallet.totalEarnings == 0
          && d.wallet.withdrawn == 0;
    }

    // المستخدم يعدّل بياناته الشخصية بس (مش الرتبة ولا الحالة ولا المحفظة)
    function selfUpdateOk() {
      return notSuspended()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'phone', 'photoURL', 'location', 'isOnline',
                         'fcmToken', 'notificationsEnabled', 'lastTokenUpdate']);
    }

    // قيود تعديل المدير على الحسابات
    function adminUpdateOk(uid) {
      let before = resource.data.get('status', 'APPROVED');
      let after = request.resource.data.get('status', 'APPROVED');
      return
        // الحساب المعطّل مينفعش يتفعّل من التطبيق: الرجوع للمطوّر (من الكونسول)
        (before != 'SUSPENDED' || after == 'SUSPENDED')
        // التعطيل لحسابات غير الأدمن، وماينفعش المدير يعطّل نفسه
        && (after != 'SUSPENDED'
            || before == 'SUSPENDED'
            || (resource.data.role != 'ADMIN' && uid != request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && validNewUser(uid);
      allow update: if signedIn() && emailOk() && (
          (request.auth.uid == uid && selfUpdateOk())
          || (isAdmin() && adminUpdateOk(uid)));
      // حذف الحساب غير المؤكد (شاشة "البريد غلط؟") أو حذف المدير
      allow delete: if signedIn() && (
          (request.auth.uid == uid && request.auth.token.email_verified != true)
          || isAdmin());
    }

    // ───────────── الطلبات ─────────────
    match /orders/{orderId} {
      allow read: if signedIn();
      allow create: if canWrite()
          && (request.resource.data.customerId == request.auth.uid || isStaff())
          && request.resource.data.status in ['DRAFT', 'PENDING'];
      allow update: if canWrite() && (
          isStaff()
          || resource.data.customerId == request.auth.uid
          || resource.data.get('driverId', '') == request.auth.uid
          || resource.data.get('assignedTo', '') == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ───────────── عروض الأسعار ─────────────
    match /offers/{offerId} {
      allow read: if signedIn();
      allow create: if canWrite()
          && request.resource.data.driverId == request.auth.uid
          && myRole() == 'DRIVER';
      allow update, delete: if canWrite()
          && (resource.data.driverId == request.auth.uid || isStaff());
    }

    // ───────────── الشات ─────────────
    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if canWrite() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ───────────── الإشعارات والرسائل الجماعية ─────────────
    function notifForMe() {
      return resource.data.userId in [request.auth.uid, 'ALL', myRole()];
    }

    function validNotif() {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId', 'title', 'body', 'type', 'key', 'orderId',
                               'createdAt', 'read', 'senderId', 'senderName'])
          && d.userId is string && d.title is string && d.body is string
          && d.title.size() <= 120 && d.body.size() <= 1000
          // البث للكل والرسائل الإدارية: للمدير والمشغّل بس
          && (d.userId != 'ALL' || isStaff())
          && (d.get('type', 'INFO') != 'ADMIN_MESSAGE' || isStaff());
    }

    match /notifications/{id} {
      allow read: if signedIn() && notifForMe();
      allow create: if canWrite() && validNotif();
      // المستخدم يقدر يغيّر حالة "مقروء" بس
      allow update: if signedIn() && notifForMe()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // ───────────── المحفظة والمدفوعات ─────────────
    match /payment_requests/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if canWrite()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'PENDING'
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
      allow update, delete: if isStaff();
    }

    match /transactions/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow write: if isAdmin();
    }

    // ───────────── الآراء والشكاوى ─────────────
    match /feedback/{id} {
      allow create: if canWrite() && request.resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow update, delete: if isAdmin();
    }

    // ───────────── الكباتن (عدّاد الطلبات) ─────────────
    match /couriers/{id} {
      allow read: if signedIn();
      allow create, delete: if isStaff();
      allow update: if canWrite() && (
          isStaff()
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['currentOrdersCount']));
    }

    // ───────────── محتوى التطبيق (للمدير بس) ─────────────
    match /ads/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /restaurants/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /geo_config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // أي حاجة تانية: مرفوضة
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
