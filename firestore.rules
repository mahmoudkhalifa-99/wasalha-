rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. شبكة أمان عامة: أي مجموعة غير معرّفة تحت ممنوعة تمامًا افتراضيًا
    match /{document=**} {
      allow read, write: if false;
    }

    // --- دوال مساعدة ---
    function isSignedIn() { return request.auth != null; }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role;
    }

    // إيميلات المديرين الافتراضية (لازم تطابق _adminEmails في firebase_service.dart)
    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'admin@ashmoun.com',
          'mahmoudkhalifa.kh91@gmail.com',
          'sadat.planning.officer@dakahlia.net',
          'admin@wasalah.com',
          'wasalah.app@gmail.com'
        ]
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        getUserData().role in ['ADMIN', 'SUPER_ADMIN']
      ));
    }

    function isOperator() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        getUserData().role in ['OPERATOR', 'ADMIN', 'SUPER_ADMIN']
      ));
    }

    function isStaff() {
      return isAdmin() || isOperator();
    }

    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- المسارات ---

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && (resource.data.id == request.auth.uid || isStaff() || resource.data.role == 'DRIVER');
      allow create: if isValidId(userId) && (
        isStaff() ||
        (isOwner(userId) && (
          (incoming().role in ['ADMIN', 'OPERATOR'] && isBootstrappedAdmin()) ||
          incoming().role == 'CUSTOMER' ||
          incoming().role == 'DRIVER'
        ))
      );
      allow update: if isValidId(userId) && (
        isStaff() ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys()
          .hasOnly(['name', 'phone', 'photoURL', 'location', 'wallet', 'plateNumber',
                    'vehicleType', 'status', 'rating', 'completedTrips', 'zoneId', 'fcmTokens']))
      );
      allow delete: if isValidId(userId) && isStaff();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (
        isOwner(existing().customerId) ||
        isOwner(existing().driverId) ||
        existing().status == 'PENDING' ||
        isStaff()
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status == 'PENDING' ||
        isStaff()
      );
      allow create: if isValidId(orderId) && isSignedIn() && (isOwner(incoming().customerId) || isStaff());
      allow update: if isValidId(orderId) && isSignedIn() && (
        isStaff() ||
        isOwner(existing().customerId) ||
        isOwner(existing().driverId) ||
        (isOwner(incoming().driverId) && existing().status == 'PENDING')
      );
      allow delete: if isValidId(orderId) && isStaff();
    }

    match /messages/{msgId} {
      allow get: if isValidId(msgId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(msgId) && isSignedIn();
      allow update, delete: if isValidId(msgId) && isStaff();
    }

    match /notifications/{notifId} {
      allow get: if isValidId(notifId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isValidId(notifId) && isSignedIn();
    }

    match /restaurants/{restId} {
      allow get, list: if true;
      allow write: if isValidId(restId) && isStaff();
    }

    match /ads/{adId} {
      allow get, list: if true;
      allow update: if isValidId(adId); // للسماح بزيادة عدّادات المشاهدات/النقرات من أي مستخدم
      allow create, delete: if isValidId(adId) && isStaff();
    }

    // مراكز وقرى المنوفية (بديل Flutter عن geo_config في نسخة الويب)
    match /zones/{zoneId} {
      allow get, list: if true;
      allow write: if isValidId(zoneId) && isStaff();
    }

    match /feedback/{feedId} {
      allow get, list: if isStaff();
      allow create: if isValidId(feedId) && isSignedIn();
      allow update, delete: if isValidId(feedId) && isStaff();
    }

    match /transactions/{transId} {
      allow get, list: if isSignedIn() && (isOwner(resource.data.userId) || isStaff());
      allow write: if isValidId(transId) && isStaff();
    }

    match /payment_requests/{requestId} {
      allow get, list: if isSignedIn() && (isOwner(resource.data.userId) || isStaff());
      allow create: if isValidId(requestId) && isSignedIn();
      allow update, delete: if isValidId(requestId) && isStaff();
    }

    // طلبات سحب أرباح الكباتن
    match /withdrawals/{withdrawalId} {
      allow get, list: if isSignedIn() && (isOwner(resource.data.driverId) || isStaff());
      allow create: if isValidId(withdrawalId) && isSignedIn() && isOwner(incoming().driverId);
      allow update, delete: if isValidId(withdrawalId) && isStaff();
    }
  }
}
