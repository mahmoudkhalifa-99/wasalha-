rules_version = '2';

// قواعد Firebase Storage لتطبيق وصلها.
// انشرها من: firebase deploy --only storage
// (أو الصقها في Firebase Console ← Storage ← Rules ← Publish)
service firebase.storage {
  match /b/{bucket}/o {

    // صور الروشتة: العميل يرفع في مجلده بس (صورة، أقل من 2 ميجا).
    // القراءة لأي مستخدم مسجّل (الكابتن لازم يشوفها). الرابط نفسه فيه توكن
    // عشوائي طويل ومش بيظهر إلا في وثيقة الطلب.
    match /prescriptions/{uid}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.size < 2 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
